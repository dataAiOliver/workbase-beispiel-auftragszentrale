# Nordwerk Auftragszentrale · Beispielkonfiguration
# Nur Platzhalter – niemals echte Zugangsdaten eintragen oder einchecken.

# HTTP-Server (PORT ist Pflicht)
PORT=4200
HOST=127.0.0.1

# PostgreSQL – Rolle muss Eigentümerin der Datenbank sein (Schema + Migrationen beim Start)
DATABASE_URL=postgres://nordwerk_orders:<passwort>@127.0.0.1:5432/nordwerk_orders

# S3-kompatibler Speicher für das Rechnungsarchiv (invoices/<jahr>/<bestellnummer>.json)
# Es wird Path-Style-Adressierung verwendet (forcePathStyle).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=nordwerk-rechnungen
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>

# Zahlungsanbieter PayNord – wird nur angezeigt/konfiguriert, die App ruft ihn nicht auf.
# PayNord liefert Zahlungsereignisse per Webhook an POST /api/webhooks/payment.
PAYMENT_PROVIDER_URL=https://api.paynord.example.invalid/v1

# Von Workbase gesetzt – Anzeige in Kopf- und Fußzeile
# WORKBASE_PROJECT=nordwerk-orders
# WORKBASE_STAGE=dev
# WORKBASE_DATASET_LABEL=
# WORKBASE_COMMIT=        # nur Fallback ohne Git-Checkout

# Tests
# WORKBASE_TEST_REPORT=.workbase/test-report.json
